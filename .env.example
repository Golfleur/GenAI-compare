# GenAI-compare Environment Variables
# Copy this file to .env and fill in your actual values
# DO NOT commit the .env file to version control

# Open WebUI API Configuration
# You can set these environment variables instead of storing credentials in config files
OPENWEBUI_API_KEY=sk-your-api-key-here
OPENWEBUI_BASE_URL=https://your-openwebui-instance.com

# Optional: Set a specific configuration name to use
# OPENWEBUI_CONFIG_NAME=production

# Note: Environment variables take precedence over YAML configuration files
# If these are set, they will override the settings in ./config/connect-owui.yaml
